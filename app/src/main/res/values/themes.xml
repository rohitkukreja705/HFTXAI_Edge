<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SDKSample" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/hftx_teal</item>
        <item name="colorPrimaryVariant">@color/hftx_surface</item>
        <item name="colorOnPrimary">@color/hftx_bg</item>
        <item name="colorSecondary">@color/hftx_gold</item>
        <item name="colorSecondaryVariant">@color/hftx_surface_elevated</item>
        <item name="colorOnSecondary">@color/hftx_bg</item>
        <item name="android:windowBackground">@color/hftx_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/hftx_bg</item>
        <item name="android:navigationBarColor">@color/hftx_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textColorPrimary">@color/hftx_text_primary</item>
        <item name="android:textColorSecondary">@color/hftx_text_secondary</item>
        <item name="android:textColor">@color/hftx_text_primary</item>
    </style>

    <style name="Theme.SDKSample.TransparentStatusBar" parent="Theme.SDKSample">
        <item name="android:statusBarColor" tools:targetApi="l">@color/hftx_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="l">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Title bar style for sub-screens -->
    <style name="HFTXTitleBar">
        <item name="android:background">@color/hftx_surface</item>
        <item name="android:textColor">@color/hftx_text_primary</item>
    </style>
</resources>
